# Copy to .env (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
TEAM_TOKEN=
DOMAIN=
MODEL_FAST=claude-sonnet-5-5
MODEL_STRONG=claude-opus-5-5
TIME_LIMIT_SEC=255
DATA_DIR=data
# Optional: path to the tesseract binary if not on PATH
TESSERACT_CMD=
FALCO_ENABLED=false
FALCO_BASE_URL=http://127.0.0.1:8000
MAX_CONCURRENT_TASKS=8
# Optional: only needed by dev_tools/record_screens.py and manual smoke tests
DESKTOP_URL=
DESKTOP_PASSWORD=
LOG_LEVEL=INFO
